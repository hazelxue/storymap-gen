{
  "$defs": {
    "AreaClaim": {
      "additionalProperties": false,
      "description": "'The polygons of layer L (optionally filtered) cover N acres / sq ft / sq m.'",
      "properties": {
        "id": {
          "pattern": "^[\\w.-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "description": "The sentence (or idea) in the story that this claim backs",
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "const": "layer_area",
          "default": "layer_area",
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "maxLength": 200,
          "title": "Layer",
          "type": "string"
        },
        "where": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "safe filter, e.g. \"name.notna()\"",
          "title": "Where"
        },
        "unit": {
          "default": "acres",
          "enum": [
            "acres",
            "sq_ft",
            "sq_m",
            "sq_km",
            "ha"
          ],
          "title": "Unit",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "number"
        },
        "tolerance": {
          "default": 0.0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "dissolve": {
          "default": true,
          "description": "merge overlapping polygons first, so overlap is not counted twice",
          "title": "Dissolve",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text",
        "layer",
        "expected"
      ],
      "title": "AreaClaim",
      "type": "object"
    },
    "BulletsBlock": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "description": "Claims that back the numbers in this block",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Claim Ids",
          "type": "array"
        },
        "type": {
          "const": "bullets",
          "default": "bullets",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "ordered": {
          "default": false,
          "title": "Ordered",
          "type": "boolean"
        }
      },
      "required": [
        "items"
      ],
      "title": "BulletsBlock",
      "type": "object"
    },
    "CoverageClaim": {
      "additionalProperties": false,
      "description": "'<share> of the study area lies within D metres of the features in layer L' (D = 0 for polygons: the share they cover).",
      "properties": {
        "id": {
          "pattern": "^[\\w.-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "description": "The sentence (or idea) in the story that this claim backs",
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "const": "area_coverage",
          "default": "area_coverage",
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "maxLength": 200,
          "title": "Layer",
          "type": "string"
        },
        "where": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Where"
        },
        "max_distance_m": {
          "default": 0.0,
          "maximum": 20000,
          "minimum": 0,
          "title": "Max Distance M",
          "type": "number"
        },
        "expected_share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Expected Share",
          "type": "number"
        },
        "tolerance": {
          "default": 0.0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "boundary_layer": {
          "default": "boundary",
          "maxLength": 200,
          "title": "Boundary Layer",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "layer",
        "expected_share"
      ],
      "title": "CoverageClaim",
      "type": "object"
    },
    "DensityClaim": {
      "additionalProperties": false,
      "description": "'The study area has N features (or N km of lines) per square kilometre.'",
      "properties": {
        "id": {
          "pattern": "^[\\w.-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "description": "The sentence (or idea) in the story that this claim backs",
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "const": "layer_density",
          "default": "layer_density",
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "maxLength": 200,
          "title": "Layer",
          "type": "string"
        },
        "where": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "safe filter, e.g. \"railway == 'station'\"",
          "title": "Where"
        },
        "measure": {
          "default": "count",
          "enum": [
            "count",
            "length_km"
          ],
          "title": "Measure",
          "type": "string"
        },
        "expected": {
          "description": "features (or km of line) per km2 of the study area",
          "title": "Expected",
          "type": "number"
        },
        "tolerance": {
          "default": 0.0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "boundary_layer": {
          "default": "boundary",
          "description": "layer holding the study-area polygon",
          "maxLength": 200,
          "title": "Boundary Layer",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "layer",
        "expected"
      ],
      "title": "DensityClaim",
      "type": "object"
    },
    "Figure": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "description": "The number as written, for example '91.9 km'",
          "maxLength": 40,
          "title": "Value",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "title": "Label",
          "type": "string"
        },
        "claim_id": {
          "anyOf": [
            {
              "pattern": "^[\\w.-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The claim that backs the number (optional)",
          "title": "Claim Id"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "Figure",
      "type": "object"
    },
    "FiguresBlock": {
      "additionalProperties": false,
      "description": "Two to four big numbers side by side. Each value is checked against the claims of this block.",
      "properties": {
        "claim_ids": {
          "description": "Claims that back the numbers in this block",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Claim Ids",
          "type": "array"
        },
        "type": {
          "const": "figures",
          "default": "figures",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Figure"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "FiguresBlock",
      "type": "object"
    },
    "HeadingBlock": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "description": "Claims that back the numbers in this block",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Claim Ids",
          "type": "array"
        },
        "type": {
          "const": "heading",
          "default": "heading",
          "title": "Type",
          "type": "string"
        },
        "level": {
          "default": 3,
          "enum": [
            3,
            4
          ],
          "title": "Level",
          "type": "integer"
        },
        "text": {
          "maxLength": 300,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "HeadingBlock",
      "type": "object"
    },
    "ImageBlock": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "description": "Claims that back the numbers in this block",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Claim Ids",
          "type": "array"
        },
        "type": {
          "const": "image",
          "default": "image",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "pattern": "^https://[^\\s]{1,2000}$",
          "title": "Url",
          "type": "string"
        },
        "alt": {
          "description": "What the picture shows, for readers who cannot see it",
          "maxLength": 300,
          "minLength": 3,
          "title": "Alt",
          "type": "string"
        },
        "caption": {
          "default": "",
          "maxLength": 500,
          "title": "Caption",
          "type": "string"
        },
        "attribution": {
          "default": "",
          "description": "Credit and licence of the picture",
          "maxLength": 300,
          "title": "Attribution",
          "type": "string"
        }
      },
      "required": [
        "url",
        "alt"
      ],
      "title": "ImageBlock",
      "type": "object"
    },
    "LayerStyle": {
      "additionalProperties": false,
      "description": "How to colour one layer of a generated map by a numeric field.",
      "properties": {
        "field": {
          "description": "The numeric column to colour by",
          "maxLength": 100,
          "title": "Field",
          "type": "string"
        },
        "method": {
          "default": "quantile",
          "description": "How to cut the values into classes",
          "enum": [
            "quantile",
            "equal",
            "manual"
          ],
          "title": "Method",
          "type": "string"
        },
        "classes": {
          "default": 5,
          "maximum": 7,
          "minimum": 2,
          "title": "Classes",
          "type": "integer"
        },
        "breaks": {
          "description": "For method=manual: classes+1 increasing numbers, the class edges",
          "items": {
            "type": "number"
          },
          "maxItems": 8,
          "title": "Breaks",
          "type": "array"
        },
        "palette": {
          "default": "blues",
          "enum": [
            "blues",
            "greens",
            "oranges",
            "reds",
            "purples",
            "teal",
            "heat"
          ],
          "title": "Palette",
          "type": "string"
        },
        "reverse": {
          "default": false,
          "description": "Dark for low values instead of high",
          "title": "Reverse",
          "type": "boolean"
        },
        "title": {
          "default": "",
          "description": "Legend and popup name of the field (default: the field name)",
          "maxLength": 80,
          "title": "Title",
          "type": "string"
        },
        "unit": {
          "default": "",
          "description": "Appended to the legend labels, e.g. '%' or ' per km2'",
          "maxLength": 20,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "title": "LayerStyle",
      "type": "object"
    },
    "LengthClaim": {
      "additionalProperties": false,
      "description": "'The lines of layer L (optionally filtered) are N km / miles / metres long in total.'",
      "properties": {
        "id": {
          "pattern": "^[\\w.-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "description": "The sentence (or idea) in the story that this claim backs",
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "const": "layer_length",
          "default": "layer_length",
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "maxLength": 200,
          "title": "Layer",
          "type": "string"
        },
        "where": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "safe filter, e.g. \"highway == 'cycleway'\"",
          "title": "Where"
        },
        "unit": {
          "default": "km",
          "enum": [
            "km",
            "mi",
            "m"
          ],
          "title": "Unit",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "number"
        },
        "tolerance": {
          "default": 0.0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "id",
        "text",
        "layer",
        "expected"
      ],
      "title": "LengthClaim",
      "type": "object"
    },
    "MapBlock": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "description": "Claims that back the numbers in this block",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Claim Ids",
          "type": "array"
        },
        "type": {
          "const": "map",
          "default": "map",
          "title": "Type",
          "type": "string"
        },
        "map": {
          "$ref": "#/$defs/MapRef"
        }
      },
      "required": [
        "map"
      ],
      "title": "MapBlock",
      "type": "object"
    },
    "MapRef": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Existing ArcGIS Web Map item id",
          "title": "Item Id"
        },
        "layers": {
          "description": "Names of data layers to draw in a generated Web Map (instead of item_id)",
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Layers",
          "type": "array"
        },
        "filters": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Per layer, the same safe filter a claim uses (for example {\"schools\": \"amenity == 'school'\"}), so the map shows exactly the features the text counts",
          "maxProperties": 12,
          "title": "Filters",
          "type": "object"
        },
        "styles": {
          "additionalProperties": {
            "$ref": "#/$defs/LayerStyle"
          },
          "description": "Per layer, colour it by a numeric field in classes (a graduated map): {\"districts\": {\"field\": \"bus_stops_per_km2\", \"palette\": \"blues\"}}",
          "maxProperties": 12,
          "title": "Styles",
          "type": "object"
        },
        "caption": {
          "default": "",
          "maxLength": 500,
          "title": "Caption",
          "type": "string"
        },
        "extent": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "xmin, ymin, xmax, ymax in Web Mercator (EPSG:3857)",
          "title": "Extent"
        }
      },
      "title": "MapRef",
      "type": "object"
    },
    "OrientationClaim": {
      "additionalProperties": false,
      "description": "'Street X is diagonal / parallel to the neighbourhood grid.'",
      "properties": {
        "id": {
          "pattern": "^[\\w.-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "description": "The sentence (or idea) in the story that this claim backs",
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "const": "street_orientation",
          "default": "street_orientation",
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "default": "streets_centerline",
          "maxLength": 200,
          "title": "Layer",
          "type": "string"
        },
        "name_field": {
          "default": "full_stree",
          "maxLength": 200,
          "title": "Name Field",
          "type": "string"
        },
        "street": {
          "maxLength": 200,
          "title": "Street",
          "type": "string"
        },
        "relation": {
          "enum": [
            "diagonal_to_grid",
            "parallel_to_grid"
          ],
          "title": "Relation",
          "type": "string"
        },
        "tolerance_deg": {
          "default": 15.0,
          "maximum": 45,
          "minimum": 0,
          "title": "Tolerance Deg",
          "type": "number"
        },
        "stated_deviation_deg": {
          "anyOf": [
            {
              "maximum": 45,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If the prose quotes the measured deviation (e.g. '37 degrees'), put it here to have it verified",
          "title": "Stated Deviation Deg"
        },
        "deviation_tolerance_deg": {
          "default": 1.0,
          "maximum": 45,
          "minimum": 0,
          "title": "Deviation Tolerance Deg",
          "type": "number"
        },
        "grid_regex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "^\\d+ (AVE|ST|RD|PL|DR|LN)$",
          "description": "Street names that define the grid (default: NYC numbered streets/avenues). null = use every segment in the layer, for cities without numbered grids.",
          "title": "Grid Regex"
        }
      },
      "required": [
        "id",
        "text",
        "street",
        "relation"
      ],
      "title": "OrientationClaim",
      "type": "object"
    },
    "ParagraphBlock": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "description": "Claims that back the numbers in this block",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Claim Ids",
          "type": "array"
        },
        "type": {
          "const": "paragraph",
          "default": "paragraph",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "maxLength": 5000,
          "title": "Text",
          "type": "string"
        },
        "cites": {
          "description": "Source keys; shown as [n] after the paragraph",
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Cites",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "ParagraphBlock",
      "type": "object"
    },
    "ProximityClaim": {
      "additionalProperties": false,
      "description": "'<share> of the features in layer A lie within D metres of features in layer B.'",
      "properties": {
        "id": {
          "pattern": "^[\\w.-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "description": "The sentence (or idea) in the story that this claim backs",
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "const": "within_distance",
          "default": "within_distance",
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "maxLength": 200,
          "title": "Layer",
          "type": "string"
        },
        "target_layer": {
          "maxLength": 200,
          "title": "Target Layer",
          "type": "string"
        },
        "target_name_field": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Name Field"
        },
        "target_names": {
          "description": "restrict the target layer to these names",
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Target Names",
          "type": "array"
        },
        "max_distance_m": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Max Distance M",
          "type": "number"
        },
        "expected_share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Expected Share",
          "type": "number"
        },
        "tolerance": {
          "default": 0.0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "id",
        "text",
        "layer",
        "target_layer",
        "max_distance_m",
        "expected_share"
      ],
      "title": "ProximityClaim",
      "type": "object"
    },
    "QuoteBlock": {
      "additionalProperties": false,
      "properties": {
        "claim_ids": {
          "description": "Claims that back the numbers in this block",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Claim Ids",
          "type": "array"
        },
        "type": {
          "const": "quote",
          "default": "quote",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        },
        "attribution": {
          "default": "",
          "maxLength": 200,
          "title": "Attribution",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "QuoteBlock",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 300,
          "title": "Title",
          "type": "string"
        },
        "intro": {
          "default": "",
          "maxLength": 10000,
          "title": "Intro",
          "type": "string"
        },
        "cites": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Cites",
          "type": "array"
        },
        "image_url": {
          "anyOf": [
            {
              "pattern": "^https://[^\\s]{1,2000}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "image_caption": {
          "default": "",
          "maxLength": 500,
          "title": "Image Caption",
          "type": "string"
        },
        "slides": {
          "items": {
            "$ref": "#/$defs/Slide"
          },
          "maxItems": 50,
          "title": "Slides",
          "type": "array"
        },
        "blocks": {

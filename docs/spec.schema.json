    },
    "ShareClaim": {
      "additionalProperties": false,
      "description": "'<share> of the features (or length, or area) of layer L match a condition', e.g. the share of street length that is living streets,\nor the share of bus stops that lie in the northern half of the study area.",
      "properties": {
        "id": {
          "pattern": "^[\\w.-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "description": "The sentence (or idea) in the story that this claim backs",
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "const": "layer_share",
          "default": "layer_share",
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "maxLength": 200,
          "title": "Layer",
          "type": "string"
        },
        "where": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the condition that defines the part, e.g. \"highway == 'living_street'\"",
          "title": "Where"
        },
        "half": {
          "anyOf": [
            {
              "enum": [
                "north",
                "south",
                "east",
                "west"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "only count features whose centre lies in this half of the study area (split at the study area's centre)",
          "title": "Half"
        },
        "of_where": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "restrict the whole to these features first (default: the whole layer)",
          "title": "Of Where"
        },
        "measure": {
          "default": "count",
          "enum": [
            "count",
            "length",
            "area"
          ],
          "title": "Measure",
          "type": "string"
        },
        "expected_share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Expected Share",
          "type": "number"
        },
        "tolerance": {
          "default": 0.0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "boundary_layer": {
          "default": "boundary",
          "description": "layer holding the study-area polygon (used by `half`)",
          "maxLength": 200,
          "title": "Boundary Layer",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "layer",
        "expected_share"
      ],
      "title": "ShareClaim",
      "type": "object"
    },

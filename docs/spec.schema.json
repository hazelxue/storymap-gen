{
  "$defs": {
    "AreaClaim": {
      "description": "'The polygons of layer L (optionally filtered) cover N acres / sq ft / sq m.'",
      "properties": {
        "id": {
          "pattern": "^[\\w.-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "description": "The sentence (or idea) in the story that this claim backs",
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "const": "layer_area",
          "default": "layer_area",
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "maxLength": 200,
          "title": "Layer",
          "type": "string"
        },
        "where": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "safe filter, e.g. \"name.notna()\"",
          "title": "Where"
        },
        "unit": {
          "default": "acres",
          "enum": [
            "acres",
            "sq_ft",
            "sq_m"
          ],
          "title": "Unit",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "number"
        },
        "tolerance": {
          "default": 0.0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "dissolve": {
          "default": true,
          "description": "merge overlapping polygons first, so overlap is not counted twice",
          "title": "Dissolve",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text",
        "layer",
        "expected"
      ],
      "title": "AreaClaim",
      "type": "object"
    },
    "LengthClaim": {
      "description": "'The lines of layer L (optionally filtered) are N km / miles / metres long in total.'",
      "properties": {
        "id": {
          "pattern": "^[\\w.-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "description": "The sentence (or idea) in the story that this claim backs",
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "const": "layer_length",
          "default": "layer_length",
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "maxLength": 200,
          "title": "Layer",
          "type": "string"
        },
        "where": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "safe filter, e.g. \"highway == 'cycleway'\"",
          "title": "Where"
        },
        "unit": {
          "default": "km",
          "enum": [
            "km",
            "mi",
            "m"
          ],
          "title": "Unit",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "number"
        },
        "tolerance": {
          "default": 0.0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "id",
        "text",
        "layer",
        "expected"
      ],
      "title": "LengthClaim",
      "type": "object"
    },
    "MapRef": {
      "description": "A map for a slide: an existing Web Map (``item_id``) or a Web Map generated from data layers (``layers``).",
      "properties": {
        "item_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Existing ArcGIS Web Map item id",
          "title": "Item Id"
        },
        "layers": {
          "description": "Names of data layers to draw in a generated Web Map (instead of item_id)",
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Layers",
          "type": "array"
        },
        "filters": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Per layer, the same safe filter a claim uses (for example {\"schools\": \"amenity == 'school'\"}), so the map shows exactly the features the text counts",
          "maxProperties": 12,
          "title": "Filters",
          "type": "object"
        },
        "caption": {
          "default": "",
          "maxLength": 500,
          "title": "Caption",
          "type": "string"
        },
        "extent": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "xmin, ymin, xmax, ymax in Web Mercator (EPSG:3857)",
          "title": "Extent"
        }
      },
      "title": "MapRef",
      "type": "object"
    },
    "OrientationClaim": {
      "description": "'Street X is diagonal / parallel to the neighbourhood grid.'",
      "properties": {
        "id": {
          "pattern": "^[\\w.-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "description": "The sentence (or idea) in the story that this claim backs",
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "const": "street_orientation",
          "default": "street_orientation",
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "default": "streets_centerline",
          "maxLength": 200,
          "title": "Layer",
          "type": "string"
        },
        "name_field": {
          "default": "full_stree",
          "maxLength": 200,
          "title": "Name Field",
          "type": "string"
        },
        "street": {
          "maxLength": 200,
          "title": "Street",
          "type": "string"
        },
        "relation": {
          "enum": [
            "diagonal_to_grid",
            "parallel_to_grid"
          ],
          "title": "Relation",
          "type": "string"
        },
        "tolerance_deg": {
          "default": 15.0,
          "maximum": 45,
          "minimum": 0,
          "title": "Tolerance Deg",
          "type": "number"
        },
        "stated_deviation_deg": {
          "anyOf": [
            {
              "maximum": 45,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If the prose quotes the measured deviation (e.g. '37 degrees'), put it here to have it verified",
          "title": "Stated Deviation Deg"
        },
        "deviation_tolerance_deg": {
          "default": 1.0,
          "maximum": 45,
          "minimum": 0,
          "title": "Deviation Tolerance Deg",
          "type": "number"
        },
        "grid_regex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "^\\d+ (AVE|ST|RD|PL|DR|LN)$",
          "description": "Street names that define the grid (default: NYC numbered streets/avenues). null = use every segment in the layer, for cities without numbered grids.",
          "title": "Grid Regex"
        }
      },
      "required": [
        "id",
        "text",
        "street",
        "relation"
      ],
      "title": "OrientationClaim",
      "type": "object"
    },
    "ProximityClaim": {
      "description": "'<share> of the features in layer A lie within D metres of features in layer B.'",
      "properties": {
        "id": {
          "pattern": "^[\\w.-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "description": "The sentence (or idea) in the story that this claim backs",
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "const": "within_distance",
          "default": "within_distance",
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "maxLength": 200,
          "title": "Layer",
          "type": "string"
        },
        "target_layer": {
          "maxLength": 200,
          "title": "Target Layer",
          "type": "string"
        },
        "target_name_field": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Name Field"
        },
        "target_names": {
          "description": "restrict the target layer to these names",
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Target Names",
          "type": "array"
        },
        "max_distance_m": {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Max Distance M",
          "type": "number"
        },
        "expected_share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Expected Share",
          "type": "number"
        },
        "tolerance": {
          "default": 0.0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        }
      },
      "required": [
        "id",
        "text",
        "layer",
        "target_layer",
        "max_distance_m",
        "expected_share"
      ],
      "title": "ProximityClaim",
      "type": "object"
    },
    "Section": {
      "properties": {
        "title": {
          "maxLength": 300,
          "title": "Title",
          "type": "string"
        },
        "intro": {
          "default": "",
          "maxLength": 10000,
          "title": "Intro",
          "type": "string"
        },
        "cites": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Cites",
          "type": "array"
        },
        "image_url": {
          "anyOf": [
            {
              "pattern": "^https://[^\\s]{1,2000}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "image_caption": {
          "default": "",
          "maxLength": 500,
          "title": "Image Caption",
          "type": "string"
        },
        "slides": {
          "items": {
            "$ref": "#/$defs/Slide"
          },
          "maxItems": 50,
          "title": "Slides",
          "type": "array"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "title"
      ],
      "title": "Section",
      "type": "object"
    },
    "Slide": {
      "properties": {
        "title": {
          "maxLength": 300,
          "title": "Title",
          "type": "string"
        },
        "body": {
          "maxLength": 5000,
          "title": "Body",
          "type": "string"
        },
        "map": {
          "anyOf": [
            {
              "$ref": "#/$defs/MapRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for the sidecar layouts"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "title",
        "body"
      ],
      "title": "Slide",
      "type": "object"
    },
    "Source": {
      "properties": {
        "key": {
          "description": "Stable id used in cites, e.g. 'nyc-lpc'",
          "pattern": "^[\\w.-]{1,64}$",
          "title": "Key",
          "type": "string"
        },
        "text": {
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "key",
        "text"
      ],
      "title": "Source",
      "type": "object"
    },
    "StatClaim": {
      "description": "'Layer L has <agg> of field F equal to N (+/- tol).'",
      "properties": {
        "id": {
          "pattern": "^[\\w.-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "description": "The sentence (or idea) in the story that this claim backs",
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "const": "layer_stat",
          "default": "layer_stat",
          "title": "Kind",
          "type": "string"
        },
        "layer": {
          "maxLength": 200,
          "title": "Layer",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "agg": {
          "enum": [
            "count",
            "min",
            "max",
            "mean",
            "sum"
          ],
          "title": "Agg",
          "type": "string"
        },
        "expected": {
          "title": "Expected",
          "type": "number"
        },
        "tolerance": {
          "default": 0.0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "where": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "safe filter, e.g. \"name.notna() and type == 'park'\"",
          "title": "Where"
        }
      },
      "required": [
        "id",
        "text",
        "layer",
        "agg",
        "expected"
      ],
      "title": "StatClaim",
      "type": "object"
    }
  },
  "properties": {
    "title": {
      "maxLength": 300,
      "title": "Title",
      "type": "string"
    },
    "subtitle": {
      "default": "",
      "maxLength": 500,
      "title": "Subtitle",
      "type": "string"
    },
    "byline": {
      "default": "",
      "maxLength": 200,
      "title": "Byline",
      "type": "string"
    },
    "locale": {
      "default": "en-us",
      "pattern": "^[a-z]{2,3}(-[A-Za-z]{2,4})?$",
      "title": "Locale",
      "type": "string"
    },
    "template": {
      "default": "docked-sidecar",
      "enum": [
        "docked-sidecar",
        "floating-sidecar",
        "longform"
      ],
      "title": "Template",
      "type": "string"
    },
    "theme": {
      "default": "slate",
      "pattern": "^[a-z0-9-]{1,40}$",
      "title": "Theme",
      "type": "string"
    },
    "cover_image_url": {
      "anyOf": [
        {
          "pattern": "^https://[^\\s]{1,2000}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cover Image Url"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "maxItems": 50,
      "title": "Sections",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "maxItems": 200,
      "title": "Sources",
      "type": "array"
    },
    "claims": {
      "items": {
        "discriminator": {
          "mapping": {
            "layer_area": "#/$defs/AreaClaim",
            "layer_length": "#/$defs/LengthClaim",
            "layer_stat": "#/$defs/StatClaim",
            "street_orientation": "#/$defs/OrientationClaim",
            "within_distance": "#/$defs/ProximityClaim"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/OrientationClaim"
          },
          {
            "$ref": "#/$defs/StatClaim"
          },
          {
            "$ref": "#/$defs/AreaClaim"
          },
          {
            "$ref": "#/$defs/LengthClaim"
          },
          {
            "$ref": "#/$defs/ProximityClaim"
          }
        ]
      },
      "maxItems": 500,
      "title": "Claims",
      "type": "array"
    },
    "allow_numbers": {
      "description": "Numbers that may appear in prose without a claim (e.g. a quoted figure from a source)",
      "items": {
        "type": "number"
      },
      "maxItems": 200,
      "title": "Allow Numbers",
      "type": "array"
    }
  },
  "required": [
    "title",
    "sections"
  ],
  "title": "StorySpec",
  "type": "object"
}

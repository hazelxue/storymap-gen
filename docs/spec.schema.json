    "StatClaim": {
      "additionalProperties": false,
      "description": "'Layer L has <agg> of field F equal to N (+/- tol).'",
      "properties": {
        "id": {
          "pattern": "^[\\w.-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "description": "The sentence (or idea) in the story that this claim backs",
          "maxLength": 1000,
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "const": "layer_stat",
